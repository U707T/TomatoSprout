<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_notification_card"
    android:paddingStart="14dp" android:paddingEnd="10dp"
    android:paddingTop="10dp" android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView
            android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_notification"
            android:background="@color/tomato"
            android:padding="2dp"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/focus_title"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1" android:ellipsize="end"
            android:textColor="#2B2424" android:textSize="13sp"
            android:text="专注中" />
        <TextView
            android:id="@+id/focus_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FF6B6B" android:textSize="20sp"
            android:textStyle="bold" android:text="25:00" />
        <ImageButton
            android:id="@+id/focus_toggle"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_pause"
            android:contentDescription="暂停或继续" />
        <ImageButton
            android:id="@+id/focus_stop"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_stop"
            android:contentDescription="结束专注" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/focus_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:max="100" android:progress="0"
        android:progressTint="#FF6B6B"
        android:progressBackgroundTint="#E8DFDA" />
</LinearLayout>
